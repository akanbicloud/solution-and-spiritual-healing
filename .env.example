# Base URL of the website, used for canonical SEO URLs, OpenGraph share previews, sitemap.xml, and RSS feed.
# Production domain: https://www.spiritualandsolutionhealing.com.ng
NEXT_PUBLIC_SITE_URL=https://www.spiritualandsolutionhealing.com.ng

# API key for Resend email service, used to send email alerts when someone books a consultation.
# Get from: https://resend.com -> Log in -> Click "API Keys" in left sidebar -> Click "Create API Key" -> Copy key starting with re_.
RESEND_API_KEY=

# The email address that receives consultation booking notification emails.
# Get from: Your own email inbox settings (enter the email address where you want to receive booking notices).
BOOKING_TO_EMAIL=

# Project ID for Sanity cloud headless CMS, used to connect the website and /studio to your Sanity project.
# Get from: https://www.sanity.io/manage -> Log in -> Click your project -> Copy "Project ID" from project overview.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset name for Sanity CMS content. Defaults to production.
# Get from: https://www.sanity.io/manage -> Click your project -> Click "Datasets" tab in top navigation.
NEXT_PUBLIC_SANITY_DATASET=

# Server-side API token used to fetch private drafts from Sanity and for database seeding.
# Get from: https://www.sanity.io/manage -> Click your project -> Click "API" tab -> "Tokens" -> Click "Add API token" (Viewer role).
SANITY_API_READ_TOKEN=

# Secret string used to secure the on-demand cache revalidation endpoint (/api/revalidate) against unauthorized triggers.
# Get from: Create your own secret string, then enter it at https://www.sanity.io/manage -> Project -> API -> Webhooks.
SANITY_REVALIDATE_SECRET=
